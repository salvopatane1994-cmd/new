---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Discesa from '../components/Discesa.astro';
import Fascia from '../components/Fascia.astro';
import Menu from '../components/Menu.astro';
import Terra from '../components/Terra.astro';
import Vino from '../components/Vino.astro';
import Ritiro from '../components/Ritiro.astro';
import Footer from '../components/Footer.astro';
import Ordine from '../components/Ordine.astro';
---

<Base>
  <TopBar />
  <main id="contenuto">
    <Discesa />
    <Fascia text="Solo asporto · Forno a legna · Milo 720 m" />
    <Menu />
    <Terra />
    <Fascia text="Ordina · Passa · Mangia" reverse />
    <Vino />
    <Ritiro />
  </main>
  <Footer />
  <Ordine />
</Base>

<script>
  import { initPage } from '../scripts/main';
  initPage();
</script>
