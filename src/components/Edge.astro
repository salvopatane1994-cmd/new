---
// Confine tra due strati: tre onde sovrapposte che sfumano dal colore sopra a quello sotto.
interface Props {
  from: string;
  to: string;
  seed?: number;
}
const { from, to, seed = 1 } = Astro.props;

function hex(c: string) {
  const n = parseInt(c.replace('#', ''), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}
function mix(a: string, b: string, t: number) {
  const [r1, g1, b1] = hex(a);
  const [r2, g2, b2] = hex(b);
  const m = (x: number, y: number) => Math.round(x + (y - x) * t);
  return `rgb(${m(r1, r2)}, ${m(g1, g2)}, ${m(b1, b2)})`;
}

const W = 1440;
const H = 140;
function wave(base: number, amp: number, k: number) {
  const pts: string[] = [];
  for (let x = 0; x <= W; x += 24) {
    const t = x / W;
    const y =
      base +
      amp * Math.sin(t * Math.PI * (2 + seed) + k * 1.7 + seed) +
      amp * 0.45 * Math.sin(t * Math.PI * (5 + k) + seed * 2.3) +
      amp * 0.2 * Math.sin(t * Math.PI * 13 + k);
    pts.push(`${x},${y.toFixed(1)}`);
  }
  return `M0,${H} L${pts.join(' L')} L${W},${H} Z`;
}

const layers = [
  { d: wave(38, 14, 1), fill: mix(from, to, 0.35), depth: 0.6 },
  { d: wave(70, 12, 2), fill: mix(from, to, 0.7), depth: 0.35 },
  { d: wave(102, 9, 3), fill: to, depth: 0.15 },
];
---

<div class="edge" style={`background:${from}`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
    {layers.map((l) => <path d={l.d} fill={l.fill} data-edge-depth={l.depth} />)}
  </svg>
</div>
