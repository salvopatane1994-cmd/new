---
import PhotoSlot from '../PhotoSlot.astro';
import { impasto } from '../../data/impasto';
---

<section id="fuoco" class="stratum fuoco" data-stratum="fuoco" data-theme="dark">
  <div class="wrap fuoco__grid">
    <div class="fuoco__copy">
      <p class="eyebrow" data-reveal>Strato 02 · Il fuoco</p>
      <h2 data-reveal>Novanta secondi<br />di <em class="fire">lava</em>.</h2>
      <p class="lead" data-reveal>
        Il forno a legna arriva a {impasto.ovenTemp} gradi, come una piccola bocca del vulcano. L'impasto ci resta
        un minuto e mezzo: abbastanza per gonfiare il cornicione, poco perché perda la sua umidità.
      </p>

      <dl class="stats" data-reveal>
        <div><dt>Temperatura</dt><dd><span data-count={impasto.ovenTemp}>{impasto.ovenTemp}</span>°</dd></div>
        <div><dt>Cottura</dt><dd><span data-count={impasto.bakeSeconds}>{impasto.bakeSeconds}</span>″</dd></div>
        <div><dt>Idratazione</dt><dd><span data-count={impasto.hydration}>{impasto.hydration}</span>%</dd></div>
      </dl>
    </div>

    <div class="fuoco__oven" aria-hidden="true">
      <div class="oven">
        <div class="oven__mouth"><div class="oven__fire" data-oven-fire></div></div>
      </div>
    </div>
  </div>

  <div class="wrap fuoco__lower">
    <article class="impasto" data-reveal data-impasto data-days={impasto.startedDaysAgo} data-hour={impasto.startedAtHour}>
      <header>
        <p class="impasto__kicker"><span class="dot" aria-hidden="true"></span> L'impasto di oggi</p>
        <p class="impasto__note">Lo aggiorna il pizzaiolo ogni mattina</p>
      </header>
      <p class="impasto__time">
        <span class="sr-only">Lievitazione in corso da</span>
        <span data-impasto-h>48</span><small>ore</small>
        <span data-impasto-m>00</span><small>min</small>
      </p>
      <p class="impasto__flour">{impasto.flour}</p>
      <h3>Stasera fuori menu</h3>
      <ul>
        {impasto.specials.map((s) => <li>{s}</li>)}
      </ul>
    </article>

    <PhotoSlot
      class="fuoco__photo"
      ratio="3 / 4"
      brief="Mani del pizzaiolo che stendono l'impasto sul banco di marmo, luce calda del forno di lato, 50 mm, poca profondità di campo."
    />
    <PhotoSlot
      class="fuoco__photo fuoco__photo--wide"
      ratio="16 / 10"
      brief="Video in loop di 6 secondi: la pala che entra nel forno, fiamme sullo sfondo. Da usare anche per Reels e profilo Google."
    />
  </div>
</section>

<style>
  .fuoco {
    background:
      radial-gradient(70% 50% at 85% 20%, rgba(226, 83, 31, 0.22), transparent 70%),
      linear-gradient(180deg, #1c0e09 0%, #130b08 100%);
    overflow: hidden;
  }

  .fuoco__grid {
    display: grid; gap: clamp(3rem, 6vw, 6rem); align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .fuoco__grid { grid-template-columns: 1.1fr 0.9fr; }
  }

  .fuoco__copy .lead { margin: 2rem 0 0; color: rgba(239, 231, 220, 0.82); }

  .stats {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem;
    margin: 3rem 0 0; padding-top: 2rem;
    border-top: 1px solid rgba(239, 231, 220, 0.15);
  }
  .stats dt {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.6;
  }
  .stats dd {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.6rem);
    line-height: 1; color: var(--lava);
    font-variant-numeric: tabular-nums;
  }

  /* Forno: una bocca ad arco che si accende scorrendo */
  .fuoco__oven { display: flex; justify-content: center; }
  .oven {
    width: min(100%, 26rem);
    aspect-ratio: 1 / 1;
    border-radius: 50% 50% 12px 12px / 60% 60% 12px 12px;
    background:
      radial-gradient(circle at 50% 30%, #3a2d27, #1b1411 70%);
    box-shadow:
      inset 0 -20px 60px rgba(0, 0, 0, 0.6),
      0 40px 120px -40px rgba(226, 83, 31, 0.5);
    display: flex; align-items: flex-end; justify-content: center;
    padding-bottom: 14%;
    position: relative;
  }
  .oven::before {
    /* pietra lavica: mattoni appena accennati */
    content: ''; position: absolute; inset: 0; border-radius: inherit; opacity: 0.25;
    background-image:
      repeating-linear-gradient(0deg, transparent 0 28px, rgba(0, 0, 0, 0.6) 28px 30px),
      repeating-linear-gradient(90deg, transparent 0 52px, rgba(0, 0, 0, 0.5) 52px 54px);
    mask-image: radial-gradient(circle at 50% 60%, transparent 35%, #000 36%);
  }
  .oven__mouth {
    width: 58%; aspect-ratio: 1.6 / 1;
    border-radius: 50% 50% 6px 6px / 90% 90% 6px 6px;
    background: #0a0605;
    overflow: hidden;
    position: relative;
    box-shadow: inset 0 10px 30px rgba(0, 0, 0, 0.9);
  }
  .oven__fire {
    position: absolute; inset: -10% -15% -30%;
    background:
      radial-gradient(40% 60% at 30% 100%, #ffd27a, transparent 70%),
      radial-gradient(50% 70% at 60% 100%, var(--lava), transparent 70%),
      radial-gradient(70% 90% at 50% 110%, var(--brace), transparent 75%);
    filter: blur(4px) saturate(1.2);
    opacity: var(--heat, 1);
    animation: flicker 1.6s ease-in-out infinite alternate;
  }
  @keyframes flicker {
    0% { transform: translateY(4%) scaleY(0.94); }
    50% { transform: translateY(0) scaleY(1.04); }
    100% { transform: translateY(2%) scaleY(0.98) skewX(2deg); }
  }

  /* Card "impasto di oggi" e foto */
  .fuoco__lower {
    display: grid; gap: 1.25rem; margin-top: clamp(4rem, 8vw, 7rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .fuoco__lower { grid-template-columns: 1fr 1fr; }
    .fuoco__photo--wide { grid-column: 1 / -1; }
  }
  @media (min-width: 1000px) {
    .fuoco__lower { grid-template-columns: 1.05fr 0.8fr 1.3fr; align-items: stretch; }
    .fuoco__photo--wide { grid-column: auto; }
  }
  .fuoco__lower :global(.photo-slot) { height: 100%; }

  .impasto {
    background: var(--osso);
    color: var(--basalto);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex; flex-direction: column;
  }
  .impasto header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; }
  .impasto__kicker {
    margin: 0; display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase;
  }
  .impasto__note { margin: 0; font-size: 0.75rem; opacity: 0.6; }
  .impasto__time {
    margin: 1.5rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 2.4rem + 3vw, 4.6rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    color: var(--magma);
  }
  .impasto__time small {
    font-family: var(--font-body); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.08em;
    color: var(--basalto); opacity: 0.6; margin: 0 0.6rem 0 0.25rem;
  }
  .impasto__flour { margin: 0 0 1.75rem; font-size: 0.9rem; opacity: 0.75; }
  .impasto h3 { font-size: 1.15rem; margin-bottom: 0.75rem; }
  .impasto ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .impasto li {
    padding: 0.6rem 0; border-top: 1px solid rgba(15, 13, 12, 0.12); font-size: 0.92rem;
  }
</style>
