---
import PhotoSlot from '../PhotoSlot.astro';
import { wines, pizzas } from '../../data/terra';

const pairings = wines.map((w) => ({ ...w, pizzas: pizzas.filter((p) => p.wine === w.id).map((p) => p.name) }));
---

<section id="vigna" class="stratum vigna" data-stratum="vigna" data-theme="dark">
  <svg class="vigna__vine" viewBox="0 0 200 1200" preserveAspectRatio="none" aria-hidden="true">
    <path
      data-vine
      d="M120,0 C60,120 170,220 110,340 C60,440 150,520 100,640 C55,750 160,840 105,960 C70,1040 130,1120 110,1200"
      pathLength="1"
    />
  </svg>

  <div class="wrap">
    <div class="vigna__head">
      <p class="eyebrow" data-reveal>Strato 04 · La vigna</p>
      <h2 class="vigna__title" data-reveal>
        <span>Solo qui.</span>
      </h2>
      <p class="lead" data-reveal>
        L'<strong>Etna Bianco Superiore</strong> si può produrre in un solo comune: Milo. Almeno l'80% di Carricante,
        coltivato sui terrazzamenti in pietra lavica del versante est, dove arriva l'aria del mare. Sedersi qui a mangiare
        una pizza vuol dire berlo a pochi passi dalla sua vigna.
      </p>
    </div>

    <div class="vigna__grid">
      <PhotoSlot
        class="vigna__photo"
        ratio="4 / 5"
        brief="Terrazzamenti di vigna a Milo al tramonto, muretti a secco di pietra lavica, il mare sullo sfondo. Da concordare con una cantina del paese."
      />

      <ul class="wines" role="list">
        {pairings.map((w, i) => (
          <li class="wine" data-reveal>
            <span class="wine__n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{w.name}</h3>
              <p class="wine__grapes">{w.grapes}</p>
              <p class="wine__note">{w.note}</p>
              {w.pizzas.length > 0 && <p class="wine__pair">Con: {w.pizzas.join(', ')}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <aside class="vinimilo" data-reveal>
      <p class="eyebrow">Ogni settembre</p>
      <p>
        Durante <strong>ViniMilo</strong> il paese diventa una cantina a cielo aperto. Noi teniamo il forno acceso fino a tardi,
        con una carta dedicata ai produttori del festival.
      </p>
    </aside>
  </div>
</section>

<style>
  .vigna {
    background:
      radial-gradient(60% 40% at 10% 0%, rgba(169, 187, 108, 0.12), transparent 70%),
      linear-gradient(180deg, var(--vigna) 0%, #0e120b 100%);
    overflow: hidden;
  }
  .vigna__vine {
    position: absolute; right: 4vw; top: 0; height: 100%; width: 140px;
    opacity: 0.5; pointer-events: none;
  }
  .vigna__vine path {
    fill: none; stroke: var(--pistacchio); stroke-width: 1.2;
    stroke-dasharray: 1; stroke-dashoffset: var(--draw, 0);
  }
  @media (max-width: 700px) { .vigna__vine { opacity: 0.2; right: -40px; } }

  .vigna__head { position: relative; max-width: 52rem; }
  .vigna__title {
    font-size: clamp(4rem, 2rem + 12vw, 12rem);
    font-style: italic; font-weight: 400;
    line-height: 0.9;
    color: var(--pistacchio);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .vigna__head .lead { margin: 2rem 0 0; color: rgba(239, 231, 220, 0.85); }
  .vigna__head strong { color: var(--osso); }

  .vigna__grid {
    display: grid; gap: clamp(2rem, 5vw, 5rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .vigna__grid { grid-template-columns: 0.9fr 1.1fr; align-items: start; }
  }

  .wines { list-style: none; margin: 0; padding: 0; }
  .wine {
    display: grid; grid-template-columns: 3rem 1fr; gap: 1rem;
    padding: 1.6rem 0;
    border-top: 1px solid rgba(169, 187, 108, 0.22);
  }
  .wine:last-child { border-bottom: 1px solid rgba(169, 187, 108, 0.22); }
  .wine__n { font-family: var(--font-display); font-size: 1.1rem; color: var(--pistacchio); padding-top: 0.3rem; }
  .wine h3 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem); }
  .wine__grapes {
    margin: 0.4rem 0 0; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--pistacchio);
  }
  .wine__note { margin: 0.5rem 0 0; opacity: 0.8; }
  .wine__pair { margin: 0.5rem 0 0; font-family: var(--font-display); font-style: italic; opacity: 0.7; }

  .vinimilo {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid rgba(169, 187, 108, 0.3);
    border-radius: var(--radius);
    max-width: 40rem;
  }
  .vinimilo p:last-child { margin: 0; }
  .vinimilo strong { color: var(--pistacchio); }
</style>
