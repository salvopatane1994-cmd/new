---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer gutter">
  <div class="inner">
    <p class="footer__big" aria-hidden="true">{site.shortName}</p>
    <p class="footer__line">{site.name} · {site.tagline} · {site.address.city}, Etna</p>
    <p class="footer__legal">
      © {year} {site.name} · P.IVA 00000000000 · <a href="#">Privacy</a> · <a href="#">Cookie</a> ·
      <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
    </p>
  </div>
</footer>

<style>
  .footer { background: var(--notte); padding-block: 3rem 2rem; overflow: hidden; }
  .footer__big {
    margin: 0 0 1rem; font-weight: 900; font-stretch: 62%; line-height: 0.75;
    font-size: clamp(9rem, 60vw, 30rem); color: var(--lava);
  }
  .footer__line { margin: 0; font-weight: 700; font-stretch: 85%; text-transform: uppercase; }
  .footer__legal { margin: 1rem 0 0; font-family: var(--mono); font-size: 0.72rem; color: var(--cenere); }
  .footer a { text-decoration: none; }
  .footer a:hover { color: var(--osso); }
</style>
