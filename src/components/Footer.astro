---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p class="footer__name">{site.name}</p>
    <div class="footer__cols">
      <p>
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city} ({site.address.province})
      </p>
      <p>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p>
        <a href={site.instagram} target="_blank" rel="noopener">Instagram</a><br />
        <a href={site.bookingUrl} target="_blank" rel="noopener">Prenota</a>
      </p>
    </div>
    <p class="footer__legal">
      © {year} {site.name} · P.IVA 00000000000 · <a href="#">Privacy</a> · <a href="#">Cookie</a>
    </p>
  </div>
</footer>

<style>
  .footer { background: var(--basalto); color: var(--osso); padding-block: clamp(4rem, 8vw, 7rem) 2rem; }
  .footer__name {
    margin: 0 0 3rem;
    font-family: var(--font-display); font-style: italic;
    font-size: clamp(2.4rem, 1rem + 8vw, 8rem); line-height: 0.95; letter-spacing: -0.04em;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    color: var(--cenere);
    -webkit-text-stroke: 1px rgba(239, 231, 220, 0.25);
  }
  .footer__cols { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .footer__cols p { margin: 0; font-size: 0.92rem; opacity: 0.8; }
  .footer a { text-decoration: none; }
  .footer a:hover { text-decoration: underline; }
  .footer__legal { margin: 3rem 0 0; font-size: 0.75rem; opacity: 0.5; }
</style>
