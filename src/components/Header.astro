---
import { site } from '../config/site';
---

<header class="header" data-header>
  <a class="brand" href="#cenere" aria-label={`${site.name}, torna all'inizio`}>
    <span class="brand__name">{site.name}</span>
    <span class="brand__alt">{site.address.altitude} m</span>
  </a>
  <nav aria-label="Sezioni">
    <ul>
      <li><a href="#fuoco">Il forno</a></li>
      <li><a href="#terra">Menu</a></li>
      <li><a href="#vigna">Vini</a></li>
      <li><a href="#superficie">Dove siamo</a></li>
    </ul>
  </nav>
  <a class="btn header__cta" href={site.bookingUrl} target="_blank" rel="noopener">Prenota</a>
</header>

<style>
  .header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1rem var(--gutter);
    color: var(--osso);
    transition: color 0.4s var(--ease), background 0.4s var(--ease), transform 0.5s var(--ease);
  }
  .header.is-scrolled {
    background: rgba(15, 13, 12, 0.72);
    backdrop-filter: blur(10px);
  }
  .header.is-light { color: var(--basalto); }
  .header.is-light.is-scrolled { background: rgba(239, 231, 220, 0.8); }
  .header.is-hidden { transform: translateY(-110%); }

  .brand { display: inline-flex; align-items: baseline; gap: 0.5rem; text-decoration: none; }
  .brand__name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    letter-spacing: -0.01em;
  }
  .brand__alt {
    font-size: 0.66rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.6;
  }

  nav ul { display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  nav a {
    text-decoration: none; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em;
    opacity: 0.8; position: relative;
  }
  nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.4s var(--ease);
  }
  nav a:hover { opacity: 1; }
  nav a:hover::after { transform: scaleX(1); }

  .header__cta { padding: 0.65rem 1.15rem; font-size: 0.85rem; }

  @media (max-width: 820px) {
    nav { display: none; }
  }
</style>
