---
import { site } from '../config/site';
---

<section id="discesa" class="discesa" data-discesa aria-label="Dal cratere al forno">
  <div class="stage">
    <canvas class="layer" data-lava aria-hidden="true"></canvas>
    <canvas class="layer" data-scene aria-hidden="true"></canvas>

    <div class="beat beat--top" data-beat="0 0.07" data-beat-in="0">
      <p class="label">{site.address.city} · Etna · {site.address.altitude} m</p>
      <h1 class="mega title" aria-label={site.name}>
        <span>Sette</span><span>cento</span><span class="lava">venti</span>
      </h1>
      <p class="sub">Pizza d'altura. Solo asporto.</p>
    </div>

    <div class="beat beat--top" data-beat="0.085 0.17">
      <p class="big">Sotto Milo<br />dorme un <span class="lava">vulcano</span>.</p>
    </div>

    <div class="beat beat--center scrim" data-beat="0.36 0.56">
      <p class="mega huge" data-temp-big>1.100°</p>
      <p class="big small">Il fuoco che ha fatto questa terra.</p>
    </div>

    <div class="beat beat--center scrim" data-beat="0.62 0.78">
      <p class="big">Lo stesso fuoco<br />è nel nostro <span class="brace">forno</span>.</p>
    </div>

    <div class="beat beat--top" data-beat="0.88 1.01">
      <p class="mega huge">90″</p>
      <p class="big small">e la tua pizza è pronta.</p>
    </div>
    <div class="beat beat--bottom" data-beat="0.9 1.01">
      <a class="btn" href="#menu">Scegli le pizze</a>
    </div>

    <div class="hud" aria-hidden="true">
      <span class="hud__temp" data-hud-temp>12 °C</span>
      <span class="hud__phase" data-hud-phase>Aria di montagna</span>
    </div>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
    <p class="hint" data-hint aria-hidden="true">Scorri per scendere nel cratere</p>
  </div>
</section>

<style>
  .discesa {
    position: relative;
    height: 560svh;
    background: var(--notte);
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    contain: strict;
  }
  .layer {
    position: absolute; inset: 0; width: 100%; height: 100%;
  }
  [data-lava] { background: #1a0603; }

  .beat {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter-r);
    z-index: 2;
    opacity: 0;
    will-change: opacity, transform;
    pointer-events: none;
  }
  .beat[data-beat-in] { opacity: 1; }
  .beat a { pointer-events: auto; }
  .beat--top { top: calc(env(safe-area-inset-top, 0px) + 84px); }
  .beat--center { top: 50%; transform: translateY(-50%); text-align: center; }
  .beat--bottom { bottom: calc(var(--bar-h) + 28px); display: flex; justify-content: center; }

  .title { display: flex; flex-direction: column; font-size: clamp(4.2rem, 25vw, 13rem); }
  .title span { display: block; }
  .sub {
    margin: 1rem 0 0;
    font-weight: 700; font-stretch: 85%; text-transform: uppercase; letter-spacing: 0.02em;
    font-size: clamp(1.1rem, 4.6vw, 1.6rem);
  }
  .huge { font-size: clamp(6rem, 38vw, 22rem); line-height: 0.8; }
  .small { font-size: clamp(1.6rem, 7vw, 3.4rem); margin-top: 0.75rem; }
  .brace { color: var(--brace); }

  .scrim::before {
    content: ''; position: absolute; inset: -30% -20%; z-index: -1;
    background: radial-gradient(closest-side, rgba(8, 4, 3, 0.72), rgba(8, 4, 3, 0));
  }
  .beat p { text-shadow: 0 2px 30px rgba(0, 0, 0, 0.45); }

  .hud {
    position: absolute; z-index: 3;
    left: var(--gutter); bottom: calc(var(--bar-h) + 14px + env(safe-area-inset-bottom, 0px));
    display: flex; gap: 0.75rem; align-items: baseline;
    font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: rgba(241, 235, 226, 0.75);
  }
  .hud__temp { color: var(--brace); font-variant-numeric: tabular-nums; min-width: 5.5em; }

  .progress {
    position: absolute; z-index: 3;
    right: calc(var(--gutter-r) - 8px); top: 30%; bottom: 30%;
    width: 2px; background: rgba(241, 235, 226, 0.15);
  }
  .progress span { position: absolute; inset: 0 0 auto 0; height: 0; background: var(--lava); }

  .hint {
    position: absolute; z-index: 3; left: 0; right: 0;
    bottom: calc(var(--bar-h) + 52px + env(safe-area-inset-bottom, 0px));
    margin: 0; text-align: center;
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(241, 235, 226, 0.7);
    animation: nudge 2.2s ease-in-out infinite;
  }
  @keyframes nudge { 50% { transform: translateY(6px); } }

  /* Senza movimento: niente scena guidata dallo scroll, solo l'apertura */
  :global(html:not(.motion)) .discesa { height: auto; }
  :global(html:not(.motion)) .stage { position: relative; }
  :global(html:not(.motion)) .hint,
  :global(html:not(.motion)) .progress { display: none; }

  @media (min-width: 900px) {
    .title { flex-direction: row; gap: 0.06em; font-size: clamp(5rem, 13vw, 14rem); }
    .beat--top { top: 14svh; }
  }
</style>
